# Variaveis publicas usadas no navegador e durante o build
VITE_SUPABASE_PROJECT_ID=seu_project_id
VITE_SUPABASE_URL=https://seu_project_id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel

# Variaveis usadas apenas pelas funcoes do servidor
SUPABASE_PROJECT_ID=seu_project_id
SUPABASE_URL=https://seu_project_id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel
SUPABASE_SERVICE_ROLE_KEY=sua_chave_secreta_service_role
